{%- liquid
  assign free_shipping_threshold_quantity = 2
  assign qualifying_product = all_products['yemeni-corner-harraz-signature-roast']
  assign qualifying_product_url = qualifying_product.url | default: '/products/yemeni-corner-harraz-signature-roast'
  assign qualifying_line_items = cart | line_items_for: qualifying_product
  assign qualifying_quantity = qualifying_line_items | sum: 'quantity'
  assign free_shipping_remaining = free_shipping_threshold_quantity | minus: qualifying_quantity
  assign free_shipping_progress = qualifying_quantity | times: 100 | divided_by: free_shipping_threshold_quantity
  if free_shipping_progress > 100
    assign free_shipping_progress = 100
  endif
-%}

<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width cart-page">
    <div class="section-header">
      <p class="eyebrow">{{ 'cart.general.checkout' | t }}</p>
      <h1 class="heading-lg">{{ 'cart.general.title' | t }}</h1>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <div class="cart-item__image">
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 220
                    | image_tag:
                      widths: '120, 180, 220',
                      sizes: '110px',
                      loading: 'lazy',
                      alt: item.product.title
                  }}
                {% else %}
                  <img src="{{ 'yemeni-corner-bag.svg' | asset_url }}" alt="{{ item.product.title | escape }}" width="900" height="1100" loading="lazy">
                {% endif %}
              </div>
              <div>
                <h2 class="heading-md"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                {% unless item.product.has_only_default_variant %}
                  <p>{{ item.variant.title }}</p>
                {% endunless %}
                <p>{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart-item__actions">
                {% render 'quantity-input', name: 'updates[]', value: item.quantity %}
                <p><a href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a></p>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="field">
          <label for="CartNote">{{ 'cart.general.note' | t }}</label>
          <textarea id="CartNote" class="textarea" name="note">{{ cart.note }}</textarea>
        </div>

        <div class="cart-summary">
          <div class="cart-offer" data-free-shipping-offer>
            <div class="cart-offer__top">
              <span>{{ 'cart.free_shipping.eyebrow' | t }}</span>
              <strong>{{ 'cart.free_shipping.heading' | t }}</strong>
            </div>
            <div class="cart-offer__track" aria-hidden="true">
              <span data-free-shipping-progress style="width: {{ free_shipping_progress }}%;"></span>
            </div>
            <p
              data-free-shipping-message
              data-free-shipping-threshold="{{ free_shipping_threshold_quantity }}"
              data-qualifying-quantity="{{ qualifying_quantity }}"
              data-message-unlocked="{{ 'cart.free_shipping.unlocked' | t | escape }}"
              data-message-empty="{{ 'cart.free_shipping.empty' | t | escape }}"
              data-message-one="{{ 'cart.free_shipping.one_remaining' | t | escape }}"
              data-message-many="{{ 'cart.free_shipping.many_remaining' | t: count: '__COUNT__' | escape }}"
            >
              {% if qualifying_quantity >= free_shipping_threshold_quantity %}
                {{ 'cart.free_shipping.unlocked' | t }}
              {% elsif qualifying_quantity == 0 %}
                {{ 'cart.free_shipping.empty' | t }}
              {% elsif free_shipping_remaining == 1 %}
                {{ 'cart.free_shipping.one_remaining' | t }}
              {% else %}
                {{ 'cart.free_shipping.many_remaining' | t: count: free_shipping_remaining }}
              {% endif %}
            </p>
          </div>
          <p class="price">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</p>
          <p class="muted">{{ 'cart.general.shipping_taxes' | t }}</p>
          <div class="button-row">
            <button class="button button--secondary" type="submit" name="update">{{ 'cart.general.update' | t }}</button>
            <button
              class="button"
              type="submit"
              name="checkout"
              data-yc-event="begin_checkout"
              data-yc-event-source="cart_page"
            >
              {{ 'cart.general.checkout' | t }}
            </button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="empty-state">
        <h2 class="heading-md">{{ 'cart.general.empty' | t }}</h2>
        <p>{{ 'cart.general.empty_detail' | t }}</p>
        <a class="button" href="{{ qualifying_product_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
