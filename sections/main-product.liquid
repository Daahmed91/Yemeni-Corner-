{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign bag_size = product.metafields.custom.bag_size.value | default: section.settings.bag_size
  if product.handle == 'yemeni-corner-harraz-signature-roast'
    assign bag_size = bag_size | replace: '340 g', '12 oz' | replace: '340 G', '12 OZ'
  endif
  assign tasting_notes = product.metafields.custom.tasting_notes.value | default: section.settings.tasting_notes
  assign roast_level = product.metafields.custom.roast_level.value | default: section.settings.roast_level
  assign roast_date = product.metafields.custom.roast_date.value | default: section.settings.roast_date
  assign coffee_process = product.metafields.custom.coffee_process.value | default: section.settings.coffee_process
  assign origin_importer = product.metafields.custom.origin_importer.value | default: section.settings.origin_importer
  assign grind_format = product.metafields.custom.grind_format.value | default: section.settings.grind_format
  assign shipping_returns = product.metafields.custom.shipping_returns.value | default: section.settings.shipping_returns
  assign brew_methods = product.metafields.custom.brew_methods.value | default: section.settings.best_for
  assign origin_context = product.metafields.custom.origin_context.value | default: section.settings.origin_context
  assign gift_message = product.metafields.custom.gift_message.value | default: section.settings.gift_message
  assign trust_copy = product.metafields.custom.trust_copy.value | default: section.settings.trust_copy
  assign product_display_title = product.title
  assign product_form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size | at_most: 4
  assign two_bag_price = current_variant.price | times: 2 | money_with_currency
  assign verified_description = product.metafields.custom.verified_structured_description.value | default: product.metafields.custom.verified_seo_description.value
  assign product_body_copy = product.description
  if verified_description != blank
    assign product_body_copy = verified_description
  elsif product.handle == 'yemeni-corner-harraz-signature-roast'
    assign product_body_copy = section.settings.description
  endif
  if product.handle == 'yemeni-corner-harraz-signature-roast'
    assign product_body_copy = product_body_copy | replace: '340 g', '12 oz' | replace: '340 G', '12 OZ'
  endif
-%}

<section
  class="section"
  data-section-id="{{ section.id }}"
  data-yc-view-item
  data-yc-product-render="signature-blend-title-2026-06-06"
  data-yc-event-item-id="{{ product.id }}"
  data-yc-event-item-name="{{ product_display_title | escape }}"
  data-yc-event-variant-id="{{ current_variant.id }}"
  data-yc-event-price="{{ current_variant.price | divided_by: 100.0 }}"
  data-yc-event-currency="{{ cart.currency.iso_code }}"
  data-market-country="{{ localization.country.iso_code }}"
>
  <div class="page-width product">
    <div class="product__media" aria-label="{{ 'products.media.gallery' | t }}">
      <div class="product__media-track" role="list" data-product-media-track>
        {% if product.media.size > 0 %}
          {% for media in product.media limit: 4 %}
            {%- liquid
              assign media_loading = 'lazy'
              assign media_fetchpriority = 'auto'
              assign media_preload = false
              assign media_alt = media.alt | default: product_display_title
              if product.handle == 'yemeni-corner-harraz-signature-roast'
                assign media_alt = media_alt | replace: '340 g', '12 oz' | replace: '340 G', '12 OZ'
              endif
              if forloop.first
                assign media_loading = 'eager'
                assign media_fetchpriority = 'high'
                assign media_preload = true
              endif
            -%}
            <figure
              class="product__media-slide{% if forloop.first %} product__media-slide--primary{% endif %}"
              role="listitem"
              aria-label="{{ 'products.media.item' | t: index: forloop.index, total: media_count }}"
            >
              {{
                media.preview_image
                | image_url: width: 1400
                | image_tag:
                  widths: '360, 520, 720, 960, 1200, 1400',
                  sizes: '(min-width: 960px) 52vw, 92vw',
                  loading: media_loading,
                  fetchpriority: media_fetchpriority,
                  preload: media_preload,
                  alt: media_alt
              }}
            </figure>
          {% endfor %}
        {% else %}
          <figure class="product__media-slide product__media-slide--primary" role="listitem">
            <img src="{{ 'yc-signature-blend-product.webp' | asset_url }}" alt="{{ product_display_title | escape }}" width="1100" height="1300" loading="eager" fetchpriority="high">
          </figure>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <p class="product__media-hint">{{ 'products.media.swipe_hint' | t }}</p>
      {% endif %}
    </div>

    <div class="product__info">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="heading-md">{{ product_display_title }}</h1>
      <p class="lead">{{ section.settings.subtitle }}</p>

      <div>
        {% render 'price', product: product %}
      </div>

      {% form 'product', product, id: product_form_id, class: 'product-form' %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          <div class="field">
            <label for="VariantSelect-{{ section.id }}">{{ 'products.product.choose_option' | t }}</label>
            <select id="VariantSelect-{{ section.id }}" class="select" name="id">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected="selected"{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class="field">
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          {% assign quantity_input_id = 'Quantity-' | append: section.id %}
          {% render 'quantity-input', id: quantity_input_id %}
          <div class="quantity-presets" aria-label="{{ 'products.product.quantity_choices' | t }}">
            <button
              type="button"
              data-quantity-preset="1"
              data-yc-event="quantity_preset"
              data-yc-event-source="product_form"
              data-yc-event-quantity="1"
              aria-pressed="true"
            >
              {{ 'products.product.one_bag' | t }}
            </button>
            <button
              type="button"
              data-quantity-preset="2"
              data-yc-event="quantity_preset"
              data-yc-event-source="product_form"
              data-yc-event-quantity="2"
              aria-pressed="false"
            >
              {{ 'products.product.two_bags_free' | t: price: two_bag_price }}
            </button>
          </div>
        </div>

        <button
          class="button"
          type="submit"
          name="add"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            {{ 'products.product.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>

        <p
          class="form-message"
          data-product-status
          data-adding-text="{{ 'products.product.adding' | t | escape }}"
          data-added-text="{{ 'products.product.added' | t | escape }}"
          aria-live="polite"
        ></p>

        {% if section.settings.show_dynamic_checkout %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}

      {% if section.settings.show_launch_offer %}
        <div class="product-offer">
          <span>{{ section.settings.offer_eyebrow }}</span>
          <strong>{{ 'products.product.two_bags_free' | t: price: two_bag_price }}</strong>
          <p>{{ section.settings.offer_text }}</p>
        </div>
      {% endif %}

      <div class="product__trust" aria-label="{{ 'products.product.highlights' | t }}">
        {% if grind_format != blank %}<span>{{ grind_format }}</span>{% endif %}
        {% if roast_date != blank %}<span>{{ roast_date }}</span>{% endif %}
        {% if section.settings.market != blank %}<span>{{ section.settings.market }}</span>{% endif %}
      </div>

      {% if trust_copy != blank %}
        <p class="product__confidence">{{ trust_copy }}</p>
      {% endif %}

      <div class="product-nudges" aria-label="{{ 'products.product.ways_to_enjoy' | t }}">
        <span>{{ 'products.product.nudge_gift' | t }}</span>
        <span>{{ 'products.product.nudge_stock' | t }}</span>
        <span>{{ 'products.product.nudge_share' | t }}</span>
      </div>

      <div class="product-meta">
        {% if tasting_notes != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.tasting_notes' | t }}</span>
            <strong>{{ tasting_notes }}</strong>
          </div>
        {% endif %}
        {% if roast_level != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.roast_level' | t }}</span>
            <strong>{{ roast_level }}</strong>
          </div>
        {% endif %}
        {% if roast_date != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.roast_date' | t }}</span>
            <strong>{{ roast_date }}</strong>
          </div>
        {% endif %}
        {% if coffee_process != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.process' | t }}</span>
            <strong>{{ coffee_process }}</strong>
          </div>
        {% endif %}
        {% if origin_importer != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.origin_importer' | t }}</span>
            <strong>{{ origin_importer }}</strong>
          </div>
        {% endif %}
        {% if grind_format != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.grind_format' | t }}</span>
            <strong>{{ grind_format }}</strong>
          </div>
        {% endif %}
        {% if brew_methods != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.best_for' | t }}</span>
            <strong>{{ brew_methods }}</strong>
          </div>
        {% endif %}
        {% if bag_size != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.in_the_bag' | t }}</span>
            <strong>{{ bag_size }} coffee{% if section.settings.market != blank %}, {{ section.settings.market }}{% endif %}</strong>
          </div>
        {% endif %}
        {% if origin_context != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.origin_context' | t }}</span>
            <strong>{{ origin_context }}</strong>
          </div>
        {% endif %}
        {% if gift_message != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.gift_note' | t }}</span>
            <strong>{{ gift_message }}</strong>
          </div>
        {% endif %}
        {% if shipping_returns != blank %}
          <div class="product-meta__item">
            <span>{{ 'products.details.shipping_returns' | t }}</span>
            <strong>{{ shipping_returns }}</strong>
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            {% render block %}
        {% endcase %}
      {% endfor %}

      {% if product_body_copy != blank %}
        <div class="rte">{{ product_body_copy }}</div>
      {% else %}
        <p class="muted">{{ section.settings.description }}</p>
      {% endif %}
    </div>
  </div>

  {% if current_variant.available %}
    <div class="product-sticky-cta" aria-label="{{ 'products.product.quick_add' | t }}">
      <div>
        <span>{{ product_display_title }}</span>
        <strong>{{ current_variant.price | money }}</strong>
      </div>
      <button class="button" type="submit" form="{{ product_form_id }}" name="add">
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Yemeni Corner Signature Blend"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Whole Bean Coffee | 12 oz | Medium Roast"
    },
    {
      "type": "text",
      "id": "tasting_notes",
      "label": "Tasting notes",
      "default": "Warm spice, cocoa, dried fruit"
    },
    {
      "type": "text",
      "id": "bag_size",
      "label": "Bag size",
      "default": "12 oz whole bean"
    },
    {
      "type": "text",
      "id": "roast_level",
      "label": "Roast level",
      "default": "Medium, smooth, aromatic"
    },
    {
      "type": "text",
      "id": "roast_date",
      "label": "Roast date"
    },
    {
      "type": "text",
      "id": "coffee_process",
      "label": "Coffee process"
    },
    {
      "type": "text",
      "id": "origin_importer",
      "label": "Origin / importer"
    },
    {
      "type": "text",
      "id": "grind_format",
      "label": "Grind / format",
      "default": "Whole bean coffee"
    },
    {
      "type": "text",
      "id": "best_for",
      "label": "Best for",
      "default": "Drip, French press, pour-over, espresso"
    },
    {
      "type": "text",
      "id": "market",
      "label": "Market",
      "default": "Canada and U.S. shipping"
    },
    {
      "type": "text",
      "id": "origin_context",
      "label": "Origin context"
    },
    {
      "type": "text",
      "id": "gift_message",
      "label": "Gift message",
      "default": "A warm coffee gift for hosts, family, holidays, and coffee lovers"
    },
    {
      "type": "textarea",
      "id": "shipping_returns",
      "label": "Shipping / returns",
      "default": "Ships to customers in Canada and the United States. Rates, taxes, and delivery options appear at checkout; returns follow the store policy for sealed coffee."
    },
    {
      "type": "textarea",
      "id": "trust_copy",
      "label": "Trust copy"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Fallback description",
      "default": "A 12 oz whole bean coffee inspired by Yemeni coffee heritage and the warmth of Yemeni Corner cafes. Expect a medium roast profile with warm spice, cocoa, and dried fruit notes. Brew it for slow mornings, shared tables, or a daily cup with more story behind it."
    },
    {
      "type": "checkbox",
      "id": "show_launch_offer",
      "label": "Show launch offer",
      "default": true
    },
    {
      "type": "text",
      "id": "offer_eyebrow",
      "label": "Offer eyebrow",
      "default": "Best First Order"
    },
    {
      "type": "textarea",
      "id": "offer_text",
      "label": "Offer text",
      "default": "Available in Canada and the United States. Keep one bag for your brew bar and gift one to someone who loves coffee with a story."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
