{% doc %}
Renders a country selector for the active Shopify markets.

@param {string} id_prefix - Unique prefix for form and input IDs.
@param {string} [class_name] - Optional modifier class.

@example
{% render 'localization-form', id_prefix: 'Footer' %}
{% enddoc %}

{%- liquid
  assign form_id = id_prefix | append: '-LocalizationForm'
  assign select_id = id_prefix | append: '-CountryCode'
  assign modifier_class = class_name | default: ''
-%}

{% if localization.available_countries.size > 1 %}
  {% form 'localization', id: form_id, class: 'localization-form' %}
    <div class="localization-form__field {{ modifier_class }}">
      <label for="{{ select_id }}">{{ 'localization.country_label' | t }}</label>
      <select id="{{ select_id }}" name="country_code" data-localization-select>
        {% for country in localization.available_countries %}
          <option
            value="{{ country.iso_code }}"
            {% if country.iso_code == localization.country.iso_code %}selected="selected"{% endif %}
          >
            {{ country.name }} ({{ country.currency.iso_code }})
          </option>
        {% endfor %}
      </select>
      <button class="button button--secondary localization-form__submit" type="submit">
        {{ 'localization.submit' | t }}
      </button>
    </div>
  {% endform %}
{% endif %}
