{%- liquid
  assign free_shipping_threshold_quantity = 2
  assign free_shipping_remaining = free_shipping_threshold_quantity | minus: cart.item_count
  assign free_shipping_progress = cart.item_count | times: 100 | divided_by: free_shipping_threshold_quantity
  if free_shipping_progress > 100
    assign free_shipping_progress = 100
  endif
-%}

<div
  class="cart-drawer"
  data-cart-drawer
  data-cart-fallback-image="{{ 'yemeni-corner-bag.svg' | asset_url }}"
  aria-hidden="true"
>
  <button class="cart-drawer__backdrop" type="button" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t }}"></button>

  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="cart-drawer__header">
      <div>
        <p class="eyebrow">Coffee Bag</p>
        <h2 id="CartDrawerTitle" class="heading-md">Added to your ritual</h2>
      </div>
      <button class="header-action" type="button" data-cart-drawer-close>{{ 'general.accessibility.close' | t }}</button>
    </div>

    <div class="cart-drawer__items" data-cart-drawer-items>
      {% if cart.item_count > 0 %}
        {% for item in cart.items limit: 4 %}
          <article class="cart-drawer__item">
            <div class="cart-drawer__image">
              {% if item.image %}
                {{
                  item.image
                  | image_url: width: 180
                  | image_tag:
                    widths: '90, 140, 180',
                    sizes: '76px',
                    loading: 'lazy',
                    alt: item.product.title
                }}
              {% else %}
                <img src="{{ 'yemeni-corner-bag.svg' | asset_url }}" alt="{{ item.product.title | escape }}" width="900" height="1100" loading="lazy">
              {% endif %}
            </div>
            <div>
              <h3>{{ item.product.title }}</h3>
              {% unless item.product.has_only_default_variant %}
                <p>{{ item.variant.title }}</p>
              {% endunless %}
              <p>{{ item.quantity }} x {{ item.final_price | money }}</p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <div class="cart-drawer__empty">
          <p>Your cart is ready for its first coffee bag.</p>
        </div>
      {% endif %}
    </div>

    <div class="cart-drawer__summary">
      <div class="cart-offer" data-free-shipping-offer>
        <div class="cart-offer__top">
          <span>2-bag offer</span>
          <strong>Free shipping in Canada</strong>
        </div>
        <div class="cart-offer__track" aria-hidden="true">
          <span data-free-shipping-progress style="width: {{ free_shipping_progress }}%;"></span>
        </div>
        <p data-free-shipping-message data-free-shipping-threshold="{{ free_shipping_threshold_quantity }}">
          {% if cart.item_count >= free_shipping_threshold_quantity %}
            Free shipping unlocked at checkout for Canadian delivery.
          {% elsif cart.item_count == 0 %}
            Add 2 bags to qualify for free shipping across Canada.
          {% elsif free_shipping_remaining == 1 %}
            Add 1 more bag to qualify for free shipping across Canada.
          {% else %}
            Add {{ free_shipping_remaining }} more bags to qualify for free shipping across Canada.
          {% endif %}
        </p>
      </div>
      <div class="cart-drawer__subtotal">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <strong data-cart-drawer-subtotal>{{ cart.total_price | money }}</strong>
      </div>
      <p class="muted">Shipping and taxes are calculated at checkout.</p>
      <div class="cart-drawer__actions">
        <form action="{{ routes.cart_url }}" method="post">
          <button
            class="button"
            type="submit"
            name="checkout"
            data-yc-event="begin_checkout"
            data-yc-event-source="cart_drawer"
          >
            {{ 'cart.general.checkout' | t }}
          </button>
        </form>
        <a class="button button--secondary" href="{{ routes.cart_url }}">{{ 'cart.general.title' | t }}</a>
      </div>
      <button class="cart-drawer__continue" type="button" data-cart-drawer-close>{{ 'cart.general.continue_shopping' | t }}</button>
    </div>
  </aside>
</div>
